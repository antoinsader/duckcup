IS_PROD=False
PORT=8000
HOST=0.0.0.0
SSL_PROTECTED=False

# If true, the app will mock testing accounts and emails
TESTING=False

# OLLAMA endpoint
OLLAMA_HOST=http://localhost:11434

# SQLite Database location
DATABASE_URL=sqlite:///./data/email_app_db.db

# Authentication
JWT_SECRET_KEY=your_jwt_secret_here

# Admin routes
SPECIAL_PASSWORD=your_admin_password_here

# Encryption key (FERNET key)
BACKEND_SECRETS_ENCRYPTION_KEY=your_encryption_key_here

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google_callback

# Frontend URL
FRONTEND_URL=http://localhost:3000/

# Data directories
USER_DATASETS_CONTENT_DIR=./data/users_datasets/
TEMP_KEYS_DB_PATH=./data/temp_keys.db

# Dataset limits
ALLOWED_PROD_USER_DS_NUM=3